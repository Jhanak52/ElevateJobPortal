@model JobFormViewModel
@{ ViewData["Title"] = "Edit job"; }

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card form-card"><div class="card-body p-4">
        <h1 class="h3 mb-3">Edit job</h1>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <partial name="_JobFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-link" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div></div>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
