@model Job
<div class="card job-card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <h3 class="h5 mb-0"><a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
            <span class="badge badge-type">@Model.Type.ToDisplay()</span>
        </div>
        <div class="text-muted mb-2">@Model.Company?.Name &middot; @Model.Location</div>
        <div class="mb-3 fw-semibold">@Model.SalaryRange</div>
        <div class="mt-auto d-flex justify-content-between align-items-center small">
            @if (Model.IsExpired)
            {
                <span class="text-danger">Closed on @Model.Deadline.ToString("dd MMM yyyy")</span>
            }
            else
            {
                <span class="text-muted">Apply by @Model.Deadline.ToString("dd MMM yyyy")</span>
            }
            <a class="btn btn-sm btn-outline-primary" asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.Id">View</a>
        </div>
    </div>
</div>
