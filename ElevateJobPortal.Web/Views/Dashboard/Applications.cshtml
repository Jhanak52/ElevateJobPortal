@model CompanyApplicationsViewModel
@{ ViewData["Title"] = "Applications"; }

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Applications</h1>
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Back to dashboard</a>
</div>

<form asp-action="Applications" method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <select name="jobId" class="form-select">
            <option value="">All jobs</option>
            @foreach (var job in Model.CompanyJobs)
            {
                <option value="@job.Id" selected="@(Model.SelectedJobId == job.Id)">@job.Title</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Filter</button></div>
</form>

@if (Model.Applications.Count == 0)
{
    <div class="alert alert-light border">No applications to show.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Applicant</th><th>Job</th><th>Applied</th><th>Cover letter</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Applications)
            {
                <tr>
                    <td>
                        @a.Applicant?.FullName<br />
                        <a class="small" href="mailto:@a.Applicant?.Email">@a.Applicant?.Email</a>
                        @if (!string.IsNullOrEmpty(a.PortfolioUrl))
                        {
                            <br /><a class="small" href="@a.PortfolioUrl" target="_blank" rel="noopener noreferrer">Portfolio / CV</a>
                        }
                    </td>
                    <td>@a.Job?.Title</td>
                    <td>@a.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="cover-cell"><details><summary>Read</summary><p class="mb-0 mt-2">@a.CoverLetter</p></details></td>
                    <td>
                        <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                            <input type="hidden" name="applicationId" value="@a.Id" />
                            <input type="hidden" name="jobId" value="@Model.SelectedJobId" />
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in Enum.GetValues<ApplicationStatus>())
                                {
                                    <option value="@s" selected="@(a.Status == s)">@s.ToDisplay()</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
