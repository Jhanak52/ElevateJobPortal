@model Job
@{ ViewData["Title"] = "Delete job"; }

<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card form-card"><div class="card-body p-4">
        <h1 class="h4 mb-3">Delete this job?</h1>
        <p><strong>@Model.Title</strong><br /><span class="text-muted">@Model.Location &middot; @Model.Type.ToDisplay()</span></p>
        <div class="alert alert-warning">Deleting a job also removes every application submitted for it. This cannot be undone.</div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a class="btn btn-link" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div></div>
</div></div>
