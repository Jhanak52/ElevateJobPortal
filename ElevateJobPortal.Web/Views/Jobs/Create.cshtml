@model JobFormViewModel
@{ ViewData["Title"] = "Post a job"; }

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="card form-card"><div class="card-body p-4">
        <h1 class="h3 mb-3">Post a job</h1>
        <form asp-action="Create" method="post" novalidate>
            <partial name="_JobFields" model="Model" />
            <button type="submit" class="btn btn-primary">Publish job</button>
            <a class="btn btn-link" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div></div>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
